# Copy to .env (gerado pelo `make setup`)

# --- App ports (lado HOST do mapping) ---------------------------------
FRONTEND_PORT=3001
BFF_PORT=3000
BACKEND_PORT=8080    # exposto SÓ em dev (via override)
MONGO_PORT=27017     # exposto SÓ em dev se você descomentar no override

# --- Image versioning -------------------------------------------------
DOCKER_REGISTRY=localhost
PROJECT_TAG=latest

# --- Secrets compartilhados entre BFF e backend -----------------------
# Em prod, gere algo random: openssl rand -hex 32
INTERNAL_TOKEN=dev-shared-secret-change-me

# --- Mongo credentials ------------------------------------------------
MONGO_USER=root
MONGO_PASS=root
